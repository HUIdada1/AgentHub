# AgentHub 部署配置模板（deploy/compose.yml 自动读同目录的 .env）
#
#   cp deploy/.env.example deploy/.env   然后只填下面两个必填项即可起服务。
#   .env 已在 .gitignore 里，不会被提交。
#
# 每一项都在 deploy/compose.yml 里有对应透传 —— compose 里没写的变量，设了也不生效
# （这正是老版本 AGENTHUB_ADMIN_HOST「能设不能传」那个坑，别再往这里加没接线的变量）。

# ── 必填（两项）──────────────────────────────────────────────

# ① 凭据加密密钥：容器内落盘用的 AES-256-GCM 主密钥。
#    自定义一个足够长的随机字符串即可（建议 32+ 字符、字母数字混合），不需要会 openssl。
#    忘掉的后果：已存进 /data 的凭据解不开（等于号池要重新同步），所以请自己存好。
#    它**不参与**与桌面版互通 —— 互通取决于两侧 WebDAV/S3 口令是否一致（口令信封 AHPPOOL1）。
AGENTHUB_SECRET_KEY=

# ② 管理令牌：Web 控制台登录密码 + 管理 API 的 Bearer 令牌（同一个值）。
#    不设会怎样（这是**刻意**的安全默认，不是配坏了）：容器照常启动、健康检查照常绿，
#    但管理面被强制降回容器回环 → 宿主端口映射转不进来，所以浏览器打不开控制台，
#    docker logs 里会有一行「未设 AGENTHUB_ADMIN_TOKEN → 管理面已从 0.0.0.0 强制降回 127.0.0.1」。
#    要远程访问：设它，并且**不要**把 AGENTHUB_ADMIN_PUBLIC 改成 0.0.0.0 裸奔，
#    交给带 TLS 的反向代理 —— 四档做法见 remote-access.md。
AGENTHUB_ADMIN_TOKEN=

# ── 可选：只读令牌（给看板/监控，不给改权限）──────────────────
# 自定义一个与完整令牌不同的密码；设了它也算「已有凭据」，安全闸照样放行。
# AGENTHUB_ADMIN_READONLY_TOKEN=

# ── 可选：镜像版本 ──────────────────────────────────────────
# 默认 latest（只有你显式 pull 才会换）。想锁住：AGENTHUB_IMAGE_TAG=2.0.5
# AGENTHUB_IMAGE_TAG=latest

# ── 可选：端口与绑定（默认值已避开桌面版的 9527/9528）─────────
# 本地网关端口（客户端连这个；OpenAI / Anthropic / Responses 三协议兼容路径 /v1）
# AGENTHUB_PROXY_PORT=19527
# 管理 API / Web 控制台端口
# AGENTHUB_ADMIN_PORT=19528
# 本地网关在容器内的绑定地址（保持默认 0.0.0.0，宿主映射需要它）
# AGENTHUB_HOST=0.0.0.0
# 管理面在**容器内**的绑定地址。保持默认 0.0.0.0：
#   改成 127.0.0.1 只会让宿主的端口映射也转不进来（容器回环 ≠ 宿主回环）。
# AGENTHUB_ADMIN_HOST=0.0.0.0
# 管理面在**宿主机**上的发布地址：
#   127.0.0.1（默认） 只有这台机器本机能打开控制台 —— 推荐
#   0.0.0.0           直接发布到所有网卡：裸端口对外，只有一个密码挡着。
#                     且**没设 AGENTHUB_ADMIN_TOKEN 时容器会拒绝启动**（这是安全闸第 ① 态）
# AGENTHUB_ADMIN_PUBLIC=127.0.0.1

# ── 可选：数据目录 ─────────────────────────────────────────
# 相对路径按 **deploy/ 目录**解析，默认 ./data 即 deploy/data。
# 容器内是 uid 1000(node) 在写，首次部署前要：
#   mkdir -p deploy/data && sudo chown 1000:1000 deploy/data
# 群晖 / 跨机部署建议直接用绝对路径，别赌相对解析：
# AGENTHUB_DATA_DIR_HOST=/vol1/docker/agenthub-data

# ── 可选：时区 ────────────────────────────────────────────
# 签到时刻与日额度重置都按它算
# TZ=Asia/Shanghai

# ── 可选：插件（**默认全部保持注释**）────────────────────────
# 形态边界与"该指哪份 feed"的权威说明在 gateway/README.md
# 「插件：容器形态只支持 v2 provider 型」一节，这里只写怎么开、不开会怎样。
#
# 固定插件 feed 到 glibc 专用索引。**一旦设置，插件页里改 feed 会被明确拒绝**
# （env 优先级高于 config → lockedByEnv=true → PUT 回 409），这是设计不是故障。
# 想要"能在界面上换源"就保持注释，改由 Web 控制台设置。
# AGENTHUB_PLUGIN_FEED=https://github.com/UltimateREN/AgentHub_skill/releases/latest/download/plugin-index-linux-x64-glibc.json
#
# 打开插件自动更新链路（启动 +90s 首查、之后每小时一轮）。默认关：
# 无人值守的服务器上自动换执行引擎不划算，手动检查/安装不受此开关影响。
# AGENTHUB_PLUGIN_AUTO_UPDATE=1
#
# 装完即信任（跳过"人工确认授权范围"，保留桌面式装完即用）。只建议个人 NAS。
# AGENTHUB_PLUGIN_TRUST_ON_INSTALL=1

# ── 可选：出站代理（全局变量，不只影响插件）────────────────────
# 插件下载在容器形态**只认这些环境变量**，不会去探本机 7897 之类的端口
# （容器里的 127.0.0.1 是它自己，探了必然假阴性）；该路径支持 http/https 与 socks5。
# 号池同步与渠道转发的出口是另一套（在 Web 控制台「号池管家 → 网络代理」里按出口配），
# 两者不要混为一谈。
# HTTPS_PROXY=http://192.168.1.10:7890
# HTTP_PROXY=http://192.168.1.10:7890

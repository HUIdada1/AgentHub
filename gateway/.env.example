# AgentHub Docker 部署环境变量模板
# 复制为 .env 后填写自己的值：cp .env.example .env
# .env 已在 .gitignore 中，不会提交到仓库

# 凭据加密密钥（必填）：AES-256-GCM，加密容器内存放的 API 凭据
# 自定义一个足够长的随机字符串即可（建议 32+ 字符，字母数字混合）
# 示例：AGENTHUB_SECRET_KEY=MySecretKey2024-DontUseThisExample
AGENTHUB_SECRET_KEY=

# 管理 API 完整令牌（可选）：管理 Web 控制台和 REST API 的登录凭据
# 自定义一个好记的密码即可（比如你的常用密码 + 项目名后缀）
# 示例：AGENTHUB_ADMIN_TOKEN=MyAdminPass-AgentHub
# 不设置时管理面只绑容器回环（127.0.0.1:9528），外部无法访问
AGENTHUB_ADMIN_TOKEN=

# 管理 API 只读令牌（可选）：日常监视/看板专用，只能读不能改
# 自定义一个与完整令牌不同的密码即可
# 示例：AGENTHUB_ADMIN_READONLY_TOKEN=ViewerOnly-AgentHub
AGENTHUB_ADMIN_READONLY_TOKEN=

# 本地网关监听端口（默认 9527）
# AGENTHUB_PROXY_PORT=9527

# 管理 API 监听端口（默认 9528）
# AGENTHUB_ADMIN_PORT=9528

# 本地网关绑定地址（默认 0.0.0.0，容器内必须暴露到宿主机）
# AGENTHUB_HOST=0.0.0.0

# 管理 API 绑定地址（默认未设 token 时 127.0.0.1，设 token 后 0.0.0.0）
# 前置反向代理（Nginx/Caddy/Traefik）做 TLS 终止时，建议保持 127.0.0.1
# AGENTHUB_ADMIN_HOST=127.0.0.1

# 业务时区（签到时刻与日额度重置按本地时间计算）
TZ=Asia/Shanghai

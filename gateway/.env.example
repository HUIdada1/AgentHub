# AgentHub Docker 部署环境变量模板
# 复制为 .env 后填写自己的值：cp .env.example .env
# .env 已在 .gitignore 中，不会提交到仓库
#
# 这个文件里的每一项，compose 都有对应透传（compose 里没写的变量设了不生效——
# 这正是阶段 0.4 修掉的老坑：AGENTHUB_ADMIN_HOST 曾「能设不能传」）。

# 凭据加密密钥（必填）：AES-256-GCM，加密容器内存放的 API 凭据
# 自定义一个足够长的随机字符串即可（建议 32+ 字符，字母数字混合）
# 示例：AGENTHUB_SECRET_KEY=MySecretKey2024-DontUseThisExample
AGENTHUB_SECRET_KEY=

# 管理 API 完整令牌（远程访问必填）：管理 Web 控制台和 REST API 的登录凭据
# 不设会怎样：入口把管理面**强制降回容器回环**并打 WARN —— 容器内绑 127.0.0.1 时宿主的
# 端口映射本就转不进来，所以管理面只是"打不开"，与升级前一致，不影响容器启动与 HEALTHCHECK。
# 例外：显式设了 AGENTHUB_ADMIN_PUBLIC=0.0.0.0（要公网）却没设 token → 入口**拒绝启动**，
# 因为那种组合等于把全权管理面裸奔到公网（方案 v2 §5.3 安全闸四态语义）。
# 自定义一个好记的密码即可（比如你的常用密码 + 项目名后缀）
# 示例：AGENTHUB_ADMIN_TOKEN=MyAdminPass-AgentHub
AGENTHUB_ADMIN_TOKEN=

# 管理 API 只读令牌（可选）：日常监视/看板专用，只能读不能改
# 自定义一个与完整令牌不同的密码即可；设了它也算「已有凭据」，安全闸照样放行
# 示例：AGENTHUB_ADMIN_READONLY_TOKEN=ViewerOnly-AgentHub
AGENTHUB_ADMIN_READONLY_TOKEN=

# ── 端口与绑定（默认值已避开桌面版的 9527/9528，见方案 v2 §D5）──────

# 本地网关监听端口（默认 19527；桌面版是 9527，同机共存不必再改）
# AGENTHUB_PROXY_PORT=19527

# 管理 API 监听端口（默认 19528）
# AGENTHUB_ADMIN_PORT=19528

# 本地网关绑定地址（默认 0.0.0.0，容器内必须暴露到宿主机）
# AGENTHUB_HOST=0.0.0.0

# 容器内管理面绑定地址（默认 0.0.0.0）
# 保持默认即可：宿主侧能不能被外网访问由下面的 AGENTHUB_ADMIN_PUBLIC 决定，
# 这里改成 127.0.0.1 只会让宿主映射也转不进来（容器回环 ≠ 宿主回环）。
# AGENTHUB_ADMIN_HOST=0.0.0.0

# 管理面在「宿主机」上的发布地址（默认 127.0.0.1 = 只有这台机器本机能打开控制台）
#   127.0.0.1  推荐；要远程访问请前置带 TLS 的反向代理（见 deploy/remote-access.md 的 B 档）
#   0.0.0.0    直接发布到所有网卡：裸端口暴露，必须先设好上面的 token，否则容器拒绝启动
# AGENTHUB_ADMIN_PUBLIC=127.0.0.1

# 宿主数据目录（默认 ../gateway-data，相对**本 compose 文件所在目录 gateway/**解析，
# 即仓库根的 gateway-data，与 README 教的 mkdir -p gateway-data 同一个位置）
# 容器以 uid 1000 运行，首次部署要：mkdir -p gateway-data && sudo chown 1000:1000 gateway-data
# 路径不确定时用绝对路径更稳：AGENTHUB_DATA_DIR_HOST=/vol1/docker/agenthub-data
# AGENTHUB_DATA_DIR_HOST=../gateway-data

# 业务时区（签到时刻与日额度重置按本地时间计算）
TZ=Asia/Shanghai

# ── 外置插件（可选，全部留默认即可用）────────────────────────

# 插件 feed 部署期换源：容器指 linux/glibc 专用索引时用
# 生效优先级：本变量 → config.json 的 plugins.feedUrl → 内置官方源
# 注意 1：本变量一设，Web 插件页的 feed 输入框就会被锁定（lockedByEnv=true，PUT 回 409），
#         所以**默认注释掉**；要改源改这里 + 重建容器，别在界面上改。
# 注意 2：只认 https 的绝对地址；写了 http:// 或畸形值会被视为"没配"，回落到下一层。
# 注意 3：文件名带 libc 段。官方 4E 产出的 linux 索引是
#           plugin-index-linux-x64-glibc.zip / plugin-index-linux-x64-glibc.json
#         （不带后缀的 plugin-index.json 是 win32/x64，容器装了会被平台校验拒）
# 示例：AGENTHUB_PLUGIN_FEED=https://github.com/UltimateREN/AgentHub_skill/releases/latest/download/plugin-index-linux-x64-glibc.json
# AGENTHUB_PLUGIN_FEED=

# 装插件是否"装完即用"（跳过人工确认授权）：默认 0 = 需确认
#   0（默认）安装后立刻停用并收回自动授予的权限与全部声明渠道，界面确认后才启用；
#   1        保留桌面式装完即用（自动授权 + 自动启用 + 自动把渠道绑到插件）。
# 公网服务器上建议保持 0；个人 NAS 想省心可设 1。
# AGENTHUB_PLUGIN_TRUST_ON_INSTALL=0

# 容器内跑插件的自动更新链路（定时器 + 到点自动装）：默认 0 = 手动
#   无人值守的服务器上"悄悄换执行引擎"风险大于收益，所以默认只允许手动检查/安装
#   （界面上的「检查更新」按钮与 POST /api/plugins/update/check 不受本开关影响）。
# AGENTHUB_PLUGIN_AUTO_UPDATE=0

